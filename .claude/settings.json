{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/db-migration-notice.sh\" block-apply",
            "timeout": 10,
            "statusMessage": "Blocking apply_migration"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/db-migration-notice.sh\" checklist",
            "timeout": 10,
            "statusMessage": "Checking for migration files"
          }
        ]
      }
    ]
  }
}
