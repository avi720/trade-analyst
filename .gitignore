# Dependencies
/node_modules

# Next.js
/.next
/out

# Build
/dist

# Environment
.env
.env.local
.env.*.local

# TypeScript
# Incremental type-check caches. The wildcard also covers one-off configs
# (tsconfig.<name>.json) whose cache lands under a different name.
*.tsbuildinfo
# Generated by next dev/build. Its contents flip between the dev and build
# variants depending on which ran last, so tracking it just churns the tree.
next-env.d.ts

# Claude Code per-machine settings (permission grants etc.) — local by
# convention; the shared config lives in .claude/settings.json.
.claude/settings.local.json

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
.vercel
.env*

# Marketing campaign (private — not for public repo)
/marketing-campaign
.gitignore.marketing-additions

